# Modelo do arquivo .env. Copie para ".env" e preencha com os dados do seu projeto.
# Supabase > Project Settings > API (ou "API Keys")
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "anon public" (ou "publishable"). NUNCA a "service_role"/"secret".
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
